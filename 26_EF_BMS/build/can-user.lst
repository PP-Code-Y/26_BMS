  85:Core/Src/can-user.c **** //CAN1中断回调函数
  86:Core/Src/can-user.c **** void HAL_CAN_RxFifo0MsgPendingCallback(CAN_HandleTypeDef *hcan){
  87:Core/Src/can-user.c **** 	uint8_t aRxData[8];
  88:Core/Src/can-user.c **** 	CAN_RxHeaderTypeDef hCAN1_RxHeader;
  89:Core/Src/can-user.c **** 	static vu8* temp_threshold = (vu8*)&E03.Threshold;
  90:Core/Src/can-user.c **** 	static vu16 threshold_id = 0x140;
  91:Core/Src/can-user.c **** 
  92:Core/Src/can-user.c **** 	if(HAL_CAN_GetRxMessage(hcan, CAN_RX_FIFO0, &hCAN1_RxHeader, aRxData) == HAL_OK){
  93:Core/Src/can-user.c **** 		if(hcan == &hcan1){
  94:Core/Src/can-user.c **** 			/*阈值恢复默认值指令*/
  95:Core/Src/can-user.c **** 			if(hCAN1_RxHeader.StdId==0x101){
  96:Core/Src/can-user.c **** 				E03.State.Init_flag=0;
  97:Core/Src/can-user.c **** 				Flash_Write_Init_Flag();	//往Flash里面存Init_Flag值
  98:Core/Src/can-user.c **** 				Threshold_Update();	//更新BMS的阈值
  99:Core/Src/can-user.c **** 				Can_Send_Package((u8*)&E03.Threshold, CAN_ID_THRESHOLD, CAN_PL_THRESHOLD, ENABLE, DISABLE);	//�
 100:Core/Src/can-user.c **** 			}
 101:Core/Src/can-user.c **** 			/*BDU更改错误位屏蔽*/
 102:Core/Src/can-user.c **** 			if(hCAN1_RxHeader.StdId==0x132){
 103:Core/Src/can-user.c **** 				E03.Alarm.error_mute=aRxData[0]+(aRxData[1]<<8)+(aRxData[2]<<16)+(aRxData[3]<<24);	
 104:Core/Src/can-user.c **** 				Flash_Write_Errormute();	//更改开机时的默认屏蔽位
 105:Core/Src/can-user.c **** 			}
 106:Core/Src/can-user.c **** 			/*BDU修改阈值*/
 107:Core/Src/can-user.c **** 			if(hCAN1_RxHeader.StdId==threshold_id){
 108:Core/Src/can-user.c **** 				for(u8 i=0; i<8; i++) {
 109:Core/Src/can-user.c **** 					*temp_threshold=aRxData[i];
 110:Core/Src/can-user.c **** 					temp_threshold++;
 111:Core/Src/can-user.c **** 				}
 112:Core/Src/can-user.c **** 				threshold_id++;
 113:Core/Src/can-user.c **** 				if(threshold_id>0X14D){			//修改到threshold数组的最后一个值, 则进行指针的复�
 114:Core/Src/can-user.c **** 					threshold_id=0x140;
