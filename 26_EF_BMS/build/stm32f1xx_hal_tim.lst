7384:Drivers/STM32F1xx_HAL_Driver/Src/stm32f1xx_hal_tim.c ****   * @param  TIM_ExtTRGPrescaler The external Trigger Prescaler.
7385:Drivers/STM32F1xx_HAL_Driver/Src/stm32f1xx_hal_tim.c ****   *          This parameter can be one of the following values:
7386:Drivers/STM32F1xx_HAL_Driver/Src/stm32f1xx_hal_tim.c ****   *            @arg TIM_ETRPRESCALER_DIV1: ETRP Prescaler OFF.
7387:Drivers/STM32F1xx_HAL_Driver/Src/stm32f1xx_hal_tim.c ****   *            @arg TIM_ETRPRESCALER_DIV2: ETRP frequency divided by 2.
7388:Drivers/STM32F1xx_HAL_Driver/Src/stm32f1xx_hal_tim.c ****   *            @arg TIM_ETRPRESCALER_DIV4: ETRP frequency divided by 4.
7389:Drivers/STM32F1xx_HAL_Driver/Src/stm32f1xx_hal_tim.c ****   *            @arg TIM_ETRPRESCALER_DIV8: ETRP frequency divided by 8.
7390:Drivers/STM32F1xx_HAL_Driver/Src/stm32f1xx_hal_tim.c ****   * @param  TIM_ExtTRGPolarity The external Trigger Polarity.
7391:Drivers/STM32F1xx_HAL_Driver/Src/stm32f1xx_hal_tim.c ****   *          This parameter can be one of the following values:
7392:Drivers/STM32F1xx_HAL_Driver/Src/stm32f1xx_hal_tim.c ****   *            @arg TIM_ETRPOLARITY_INVERTED: active low or falling edge active.
7393:Drivers/STM32F1xx_HAL_Driver/Src/stm32f1xx_hal_tim.c ****   *            @arg TIM_ETRPOLARITY_NONINVERTED: active high or rising edge active.
7394:Drivers/STM32F1xx_HAL_Driver/Src/stm32f1xx_hal_tim.c ****   * @param  ExtTRGFilter External Trigger Filter.
7395:Drivers/STM32F1xx_HAL_Driver/Src/stm32f1xx_hal_tim.c ****   *          This parameter must be a value between 0x00 and 0x0F
7396:Drivers/STM32F1xx_HAL_Driver/Src/stm32f1xx_hal_tim.c ****   * @retval None
7397:Drivers/STM32F1xx_HAL_Driver/Src/stm32f1xx_hal_tim.c ****   */
